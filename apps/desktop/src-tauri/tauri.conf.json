{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolzy",
  "version": "0.1.0",
  "identifier": "com.toolzy.app",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter @toolzy/web dev",
    "beforeBuildCommand": "pnpm --filter @toolzy/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Toolzy",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"]
  }
}
