{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolzy",
  "version": "0.1.16",
  "identifier": "com.toolzy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Toolzy",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/guilhermeeng99/Toolzy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4MkZBMTY2OUIzNDFEMQpSV1RSUWJOcEZ2cUNEZkdJQVpmT09hZHRqY0dPUjlrdytaR3lPRElxRlFwN0NLWDY1UXJmeUV0ago="
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/yt-dlp",
      "binaries/ffmpeg",
      "binaries/qpdf",
      "binaries/whisper-cli"
    ],
    "resources": {
      "pdfium/*": "pdfium/",
      "binaries/*.dll": ""
    }
  }
}
