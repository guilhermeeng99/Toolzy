{
  "name": "toolzy",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @toolzy/web dev",
