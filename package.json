{
  "name": "toolzy",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter @toolzy/web dev",
    "build": "turbo run build",
    "start": "pnpm --filter @toolzy/web start",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.0",
    "vitest": "^2.1.8"
  }
}
